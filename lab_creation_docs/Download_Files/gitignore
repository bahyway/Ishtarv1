*.sql.gz

# Database backups
*.backup
*.bak

# ============================================================
# LARGE DATA FILES
# ============================================================

# CSV files (if large)
# Uncomment if you have large CSV files:
# *.csv

# JSON data files (if large)
# Uncomment if you have large JSON files:
# *.json

# Binary data
*.bin
*.dat

# Archives (usually large)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ============================================================
# DOCKER & CONTAINERS
# ============================================================

# Docker volumes data
docker-volumes/

# ============================================================
# PARTICLESWAY SPECIFIC (3D Graphics)
# ============================================================

# Compiled shaders
*.spv
*.spirv

# 3D model caches
*.cache

# Large 3D assets (if any)
# *.obj
# *.fbx
# *.gltf
# *.glb

# ============================================================
# ZEROWAY SPECIFIC (Security)
# ============================================================

# Security keys (NEVER commit these!)
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*

# Certificates
*.crt
*.cer
*.der

# Secrets
secrets/
*.secret

# ============================================================
# NODE/NPM (if you add JavaScript tools later)
# ============================================================

node_modules/
package-lock.json
yarn.lock

# ============================================================
# PYTHON (if you add Python tools later)
# ============================================================

__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
.venv

# ============================================================
# CUSTOM EXCLUDES FOR BAHYWAY
# ============================================================

# Large test data
/test-data/*.csv
/test-data/*.json

# Generated reports
/reports/

# Experimental code
/experiments/
/scratch/

# ============================================================
# NOTES
# ============================================================

# The target/ directory is the biggest culprit - it contains:
# - All compiled binaries
# - All dependencies (compiled)
# - Debug symbols
# Can easily be 5-10 GB for a workspace like this!

# The Cargo registry cache (~/.cargo/) can be:
# - 10+ GB if you work on many projects
# - But it's not in your repo, so not a concern for git

# If your repo is still large after this .gitignore:
# 1. Check for accidentally committed target/ directories:
#    git rm -r --cached target
# 2. Check for large files:
#    git rev-list --objects --all | \
#    git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' | \
#    sed -n 's/^blob //p' | sort --numeric-sort --key=2 | tail -n 10
# 3. Use git-filter-repo to remove them from history if needed

# ============================================================
