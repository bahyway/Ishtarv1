*.tmp
*.temp
*.bak
*.backup

# Log files
*.log
logs/

# Environment variables
.env
.env.local
.env.*.local

# ============================================================
# TESTING & COVERAGE
# ============================================================

# Test artifacts
/tests/tmp/
/coverage/
*.profraw
*.profdata

# Criterion benchmark results
/target/criterion/

# ============================================================
# DOCUMENTATION
# ============================================================

# Generated documentation (can be regenerated)
/target/doc/
**/target/doc/

# mdBook build output
/book/

# ============================================================
# DATABASE FILES (Can be large!)
# ============================================================

# SQLite
*.sqlite
*.sqlite3
*.db

