{
  "name": "EnkiDB Manifold Dark",
  "type": "dark",
  "colors": {
    "editor.background":             "#060610",
    "editor.foreground":             "#C8D0E0",
    "editorLineNumber.foreground":   "#2A3050",
    "editorLineNumber.activeForeground": "#FFD700",
    "editor.selectionBackground":    "#FFD70030",
    "editor.wordHighlightBackground":"#00FFFF18",
    "editorCursor.foreground":       "#FFD700",
    "editor.lineHighlightBackground":"#0D0D22",

    "activityBar.background":        "#04040E",
    "activityBar.foreground":        "#FFD700",
    "activityBarBadge.background":   "#FFD700",
    "activityBarBadge.foreground":   "#04040E",

    "sideBar.background":            "#06060F",
    "sideBar.foreground":            "#8899BB",
    "sideBarTitle.foreground":       "#FFD700",
    "sideBarSectionHeader.background":"#0A0A1A",
    "sideBarSectionHeader.foreground":"#FFD700",

    "statusBar.background":          "#0A0A2A",
    "statusBar.foreground":          "#FFD700",
    "statusBarItem.hoverBackground": "#FFD70020",

    "titleBar.activeBackground":     "#04040E",
    "titleBar.activeForeground":     "#FFD700",

    "tab.activeBackground":          "#0D0D22",
    "tab.activeForeground":          "#FFD700",
    "tab.inactiveBackground":        "#06060F",
    "tab.inactiveForeground":        "#445566",
    "tab.activeBorder":              "#FFD700",

    "panel.background":              "#04040E",
    "panelTitle.activeForeground":   "#FFD700",
    "terminal.background":           "#04040E",
    "terminal.foreground":           "#C8D0E0",
    "terminal.ansiGreen":            "#00FF88",
    "terminal.ansiCyan":             "#00FFFF",
    "terminal.ansiMagenta":          "#CC44FF",
    "terminal.ansiYellow":           "#FFD700",

    "list.activeSelectionBackground":"#FFD70020",
    "list.activeSelectionForeground":"#FFD700",
    "list.hoverBackground":          "#FFD70010",

    "scrollbar.shadow":              "#00000080",
    "scrollbarSlider.background":    "#FFD70020",
    "scrollbarSlider.hoverBackground":"#FFD70040",

    "editorBracketHighlight.foreground1": "#FFD700",
    "editorBracketHighlight.foreground2": "#00FFFF",
    "editorBracketHighlight.foreground3": "#CC44FF",
    "editorBracketHighlight.foreground4": "#00FF88",
    "editorBracketHighlight.foreground5": "#FF8C00",

    "gitDecoration.modifiedResourceForeground":  "#00FFFF",
    "gitDecoration.addedResourceForeground":     "#00FF88",
    "gitDecoration.deletedResourceForeground":   "#FF4466",
    "gitDecoration.untrackedResourceForeground": "#CC44FF"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#2A4060", "fontStyle": "italic" }
    },
    {
      "name": "Akkadian Top-Level Keywords (CONTEXT, IDENTITY, STORAGE…)",
      "scope": "keyword.control.akkadian",
      "settings": { "foreground": "#FFD700", "fontStyle": "bold" }
    },
    {
      "name": "Akkadian Storage Keywords (HUB, SATELLITE, LINK…)",
      "scope": "keyword.other.storage.akkadian",
      "settings": { "foreground": "#00FFFF", "fontStyle": "bold" }
    },
    {
      "name": "Akkadian Identity Keywords",
      "scope": "keyword.other.identity.akkadian",
      "settings": { "foreground": "#CC44FF" }
    },
    {
      "name": "Akkadian Tribe/Particle Constants",
      "scope": "constant.language.tribe.akkadian",
      "settings": { "foreground": "#00FF88", "fontStyle": "bold" }
    },
    {
      "name": "Akkadian Algorithm Names",
      "scope": "support.function.algorithm.akkadian",
      "settings": { "foreground": "#FF8C00" }
    },
    {
      "name": "Akkadian Entity / Context Name",
      "scope": "entity.name.class.akkadian",
      "settings": { "foreground": "#FFD700", "fontStyle": "bold" }
    },
    {
      "name": "Data Types (UUID, VARCHAR, GEOMETRY…)",
      "scope": ["support.type", "support.type.akkadian"],
      "settings": { "foreground": "#00FFFF" }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": { "foreground": "#DEB887" }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": { "foreground": "#FF8C00" }
    },
    {
      "name": "Color Hex Literals",
      "scope": "constant.language.color.akkadian",
      "settings": { "foreground": "#FF8C00", "fontStyle": "bold" }
    },
    {
      "name": "Booleans / Null",
      "scope": "constant.language",
      "settings": { "foreground": "#CC44FF" }
    },
    {
      "name": "Rust Keywords",
      "scope": ["keyword.other.rust", "keyword.control.rust", "storage.type.rust"],
      "settings": { "foreground": "#FFD700" }
    },
    {
      "name": "Rust Function Names",
      "scope": "entity.name.function.rust",
      "settings": { "foreground": "#00FF88" }
    },
    {
      "name": "Rust Types / Structs",
      "scope": ["entity.name.type.rust", "support.type.rust"],
      "settings": { "foreground": "#00FFFF" }
    },
    {
      "name": "Rust Macros",
      "scope": "meta.macro.rust",
      "settings": { "foreground": "#FF8C00", "fontStyle": "italic" }
    },
    {
      "name": "Rust Lifetimes",
      "scope": "storage.modifier.lifetime.rust",
      "settings": { "foreground": "#CC44FF", "fontStyle": "italic" }
    },
    {
      "name": "Lean 4 Keywords",
      "scope": ["keyword.lean4", "keyword.control.lean4"],
      "settings": { "foreground": "#FFD700" }
    },
    {
      "name": "Lean 4 Theorem Names",
      "scope": "entity.name.theorem.lean4",
      "settings": { "foreground": "#00FF88", "fontStyle": "bold" }
    },
    {
      "name": "Python Keywords",
      "scope": ["keyword.control.python", "storage.type.python"],
      "settings": { "foreground": "#FFD700" }
    },
    {
      "name": "Python Function Names",
      "scope": "entity.name.function.python",
      "settings": { "foreground": "#00FF88" }
    },
    {
      "name": "GLSL Built-in Types",
      "scope": "storage.type.glsl",
      "settings": { "foreground": "#00FFFF" }
    },
    {
      "name": "GLSL Built-in Functions",
      "scope": "support.function.glsl",
      "settings": { "foreground": "#FF8C00" }
    },
    {
      "name": "SQL Keywords",
      "scope": "keyword.other.sql",
      "settings": { "foreground": "#FFD700" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#C8D0E0" }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": { "foreground": "#8899BB" }
    },
    {
      "name": "Punctuation Brackets",
      "scope": "punctuation.definition.block",
      "settings": { "foreground": "#445577" }
    }
  ]
}
