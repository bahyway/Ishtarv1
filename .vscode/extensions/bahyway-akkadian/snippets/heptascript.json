{
  "HeptaScript SELECT": {
    "prefix": "sel",
    "body": [
      "SELECT particle",
      "WHERE state = ${1:Golden}",
      "  AND tribe = ${2:tribe_id}",
      "LIMIT ${3:100}"
    ],
    "description": "HeptaScript particle SELECT query"
  },
  "HeptaScript SCAN ALL": {
    "prefix": "scan",
    "body": [
      "SCAN ALL particles",
      "WHERE d4_quality > ${1:0.70}",
      "ORDER BY hps DESC",
      "LIMIT ${2:50}"
    ],
    "description": "HeptaScript full scan ordered by HPS"
  },
  "HeptaScript NEAREST": {
    "prefix": "near",
    "body": [
      "SELECT particle",
      "NEAREST (d1=${1:0.5}, d2=${2:0.5}, d3=${3:0.5}, d4=${4:0.8}, d5=${5:0.9}, d6=${6:0.5}, d7=${7:0.95})",
      "LIMIT ${8:10}"
    ],
    "description": "HeptaScript nearest-neighbour query in 7D Hepta space"
  }
}
