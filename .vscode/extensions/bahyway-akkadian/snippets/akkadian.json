{
  "AAOL Tribe Block": {
    "prefix": "tribe",
    "body": [
      "tribe ${1:TribeName} {",
      "\tactor ${2:ActorName} {",
      "\t\trole ${3:Zikru}",
      "\t}",
      "}"
    ],
    "description": "AAOL tribe declaration with actor and role"
  },
  "AAOL Context Block": {
    "prefix": "context",
    "body": [
      "CONTEXT ${1:ContextName} {",
      "\tIDENTITY {",
      "\t\tBUSINESS_KEY: ${2:key_field}",
      "\t\tALGORITHM: ${3:cosine}",
      "\t}",
      "\tSTORAGE {",
      "\t\t$4",
      "\t}",
      "}"
    ],
    "description": "Full AAOL CONTEXT block skeleton"
  },
  "KAKI Identity Block": {
    "prefix": "kaki",
    "body": [
      "KAKI {",
      "\tTRIBE: ${1:tribe_id}",
      "\tZIKRU: ${2:role}",
      "\tORBIT: ${3:domain}",
      "}"
    ],
    "description": "KAKI sovereign identity block"
  }
}
