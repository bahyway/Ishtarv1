{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HeptaScript",
  "scopeName": "source.heptascript",
  "fileTypes": ["zik", "hs7"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#query-keywords" },
    { "include": "#particle-states" },
    { "include": "#hepta-dimensions" },
    { "include": "#aggregates" },
    { "include": "#literals" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.heptascript",
          "match": "//.*$"
        },
        {
          "name": "comment.block.heptascript",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "query-keywords": {
      "name": "keyword.control.heptascript",
      "match": "\\b(SELECT|FROM|WHERE|AND|OR|NOT|LIMIT|ORDER|BY|ASC|DESC|SCAN|ALL|STREAM|BATCH|JOIN|GROUP|HAVING|WITH|AS|particle|particles|state|tribe|sector|hepta|kaki)\\b"
    },
    "particle-states": {
      "name": "constant.language.state.heptascript",
      "match": "\\b(Golden|Dead|Fuzzy|Gray|Occupied|Reserved|Available|Sealed|Active|Suspected|Defective|Healthy)\\b"
    },
    "hepta-dimensions": {
      "name": "support.variable.dimension.heptascript",
      "match": "\\b(d1_identity|d2_belonging|d3_domain|d4_quality|d5_freshness|d6_temporal|d7_integrity|hps|similarity)\\b"
    },
    "aggregates": {
      "name": "support.function.aggregate.heptascript",
      "match": "\\b(COUNT|SUM|AVG|MIN|MAX|SORT|RANK|TOP|NEAREST|COSINE|HPS)\\b"
    },
    "literals": {
      "patterns": [
        {
          "name": "string.quoted.double.heptascript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.heptascript", "match": "\\\\." }
          ]
        },
        {
          "name": "constant.numeric.float.heptascript",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.heptascript",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.numeric.hex.heptascript",
          "match": "0x[0-9A-Fa-f]+"
        },
        {
          "name": "constant.language.boolean.heptascript",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.heptascript",
          "match": "(>=|<=|!=|==|>|<|=)"
        },
        {
          "name": "keyword.operator.logical.heptascript",
          "match": "(&&|\\|\\|)"
        },
        {
          "name": "punctuation.separator.heptascript",
          "match": "[,;]"
        },
        {
          "name": "punctuation.definition.block.heptascript",
          "match": "[{}\\[\\]()]"
        }
      ]
    },
    "identifiers": {
      "name": "variable.other.heptascript",
      "match": "\\b[a-z_][a-z0-9_]*\\b"
    }
  }
}
