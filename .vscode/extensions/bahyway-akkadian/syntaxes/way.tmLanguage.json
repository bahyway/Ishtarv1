{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WAYv2.0 Security Policy",
  "scopeName": "source.wayv2",
  "fileTypes": ["way"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#policy-block" },
    { "include": "#policy-keywords" },
    { "include": "#action-keywords" },
    { "include": "#condition-keywords" },
    { "include": "#severity-levels" },
    { "include": "#literals" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.wayv2",
          "match": "//.*$"
        },
        {
          "name": "comment.block.wayv2",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "policy-block": {
      "match": "\\b(POLICY|PROTOCOL|LAYER|RULE|TRIGGER)\\s+([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.block.wayv2" },
        "2": { "name": "entity.name.class.wayv2" }
      }
    },
    "policy-keywords": {
      "name": "keyword.control.wayv2",
      "match": "\\b(POLICY|PROTOCOL|LAYER|RULE|TRIGGER|WHEN|THEN|ELSE|END|IF|WITH|FOR|ON|AT|IN)\\b"
    },
    "action-keywords": {
      "name": "keyword.other.action.wayv2",
      "match": "\\b(ALLOW|DENY|AUDIT|LOG|ALERT|BLOCK|QUARANTINE|NOTIFY|ESCALATE|ENCRYPT|VERIFY|SIGN|REVOKE|GRANT|RESTRICT)\\b"
    },
    "condition-keywords": {
      "name": "support.function.condition.wayv2",
      "match": "\\b(MATCHES|CONTAINS|EXCEEDS|BELOW|EQUALS|NOT_EQUALS|IS_MEMBER|HAS_ROLE|IS_TRIBE|IS_SOVEREIGN|HAS_KAKI|EXPIRED|VALID|FRESH)\\b"
    },
    "severity-levels": {
      "name": "constant.language.severity.wayv2",
      "match": "\\b(CRITICAL|HIGH|MEDIUM|LOW|INFO|SOVEREIGN|EMERGENCY|URGENT|PLANNED|ROUTINE)\\b"
    },
    "literals": {
      "patterns": [
        {
          "name": "string.quoted.double.wayv2",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.wayv2", "match": "\\\\." }
          ]
        },
        {
          "name": "constant.numeric.duration.wayv2",
          "match": "\\b[0-9]+(ms|s|m|h|d)\\b"
        },
        {
          "name": "constant.numeric.float.wayv2",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.wayv2",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.language.boolean.wayv2",
          "match": "\\b(true|false|TRUE|FALSE)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.wayv2",
          "match": "(>=|<=|!=|==|>|<|=|->|=>)"
        },
        {
          "name": "keyword.operator.logical.wayv2",
          "match": "\\b(AND|OR|NOT|XOR)\\b"
        },
        {
          "name": "punctuation.separator.wayv2",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.definition.block.wayv2",
          "match": "[{}\\[\\]()]"
        }
      ]
    },
    "identifiers": {
      "name": "variable.other.wayv2",
      "match": "\\b[a-z_][a-z0-9_]*\\b"
    }
  }
}
