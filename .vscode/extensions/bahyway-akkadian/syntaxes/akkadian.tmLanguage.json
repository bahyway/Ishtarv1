{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Akkadian AAOL",
  "scopeName": "source.akkadian",
  "fileTypes": ["ak", "akk"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#orchestration-keywords" },
    { "include": "#pmpvd-keywords" },
    { "include": "#data-types" },
    { "include": "#literals" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.akkadian",
          "match": "#.*$"
        }
      ]
    },
    "orchestration-keywords": {
      "comment": "crates/aaol/src/token.rs orchestration layer: tribe/actor/event/route",
      "name": "keyword.control.orchestration.akkadian",
      "match": "(?i)\\b(tribe|actor|role|when|event|then|emit|snapshot|route|to)\\b"
    },
    "pmpvd-keywords": {
      "comment": "crates/aaol/src/token.rs PMPVD layer: particle/rule/equation/guard/flow/observe/pipeline",
      "name": "keyword.control.pmpvd.akkadian",
      "match": "(?i)\\b(particle|rule|equation|guard|flow|observe|pipeline|weights|ideal|and|lane|orbit|from|where|sort|limit|source|pipe|sink|require|allow|asc|desc)\\b"
    },
    "data-types": {
      "comment": "crates/aaol/src/token.rs Token::Text / Token::KakiType",
      "name": "support.type.akkadian",
      "match": "(?i)\\b(text|kaki)\\b"
    },
    "literals": {
      "patterns": [
        {
          "name": "string.quoted.double.akkadian",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.akkadian", "match": "\\\\." }
          ]
        },
        {
          "name": "constant.numeric.float.akkadian",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.akkadian",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.akkadian",
          "match": "(>=|<=|>|<|=)"
        },
        {
          "name": "punctuation.definition.block.akkadian",
          "match": "[{}\\[\\]()]"
        },
        {
          "name": "punctuation.separator.akkadian",
          "match": "[,:;.]"
        }
      ]
    },
    "identifiers": {
      "name": "variable.other.akkadian",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
