{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Akkadian DSL",
  "scopeName": "source.akkadian",
  "fileTypes": ["ak", "akk"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#context-block" },
    { "include": "#top-level-keywords" },
    { "include": "#storage-keywords" },
    { "include": "#identity-keywords" },
    { "include": "#data-types" },
    { "include": "#tribe-colors" },
    { "include": "#algorithms" },
    { "include": "#literals" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.akkadian",
          "match": "//.*$"
        },
        {
          "name": "comment.block.akkadian",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "context-block": {
      "name": "entity.name.namespace.akkadian",
      "match": "\\b(CONTEXT)\\s+([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.context.akkadian" },
        "2": { "name": "entity.name.class.akkadian" }
      }
    },
    "top-level-keywords": {
      "name": "keyword.control.akkadian",
      "match": "\\b(CONTEXT|IDENTITY|STORAGE|VECTORIZATION|COMMAND|RAG_QUERY|PRESENTATION|RULESET|META_ALGORITHMICS|DataVault|WITH|AS|FROM|WHERE|SELECT|USING|MATCH|ON|BY|DO|END)\\b"
    },
    "storage-keywords": {
      "name": "keyword.other.storage.akkadian",
      "match": "\\b(HUB|SATELLITE|LINK|ANCHOR|KNOT|ATTRIBUTE|TIE|temporal_tracking|PARTITION_BY|CLUSTERED_BY|HASH|RANGE|LIST|BTREE|GIN|GIST|BRIN|SPGIST)\\b"
    },
    "identity-keywords": {
      "name": "keyword.other.identity.akkadian",
      "match": "\\b(BUSINESS_KEY|FUZZY_RESOLUTION|SPATIAL_ID|ALGORITHM|DIMENSIONS|PRECISION|THRESHOLD|QUALITY|SOVEREIGN|ACTIVE|POOR|NON_ACTIVE|KAKI|ZIKRU|ORBIT|TRIBE|FERMI|MANIFOLD)\\b"
    },
    "data-types": {
      "name": "support.type.akkadian",
      "match": "\\b(UUID|VARCHAR|INT|BIGINT|SMALLINT|DECIMAL|FLOAT|DOUBLE|TIMESTAMP|TIMESTAMPTZ|DATE|BOOLEAN|GEOMETRY|VECTOR|TEXT|BYTEA|JSONB|JSON|ARRAY)\\b"
    },
    "tribe-colors": {
      "name": "constant.language.tribe.akkadian",
      "match": "\\b(SOVEREIGN_GEM|ACTIVE_TRIBE_NODE|POOR_QUALITY_NODE|NON_ACTIVE_PATHOGEN|GREEN_GALAXY|CYAN_GALAXY|VIOLET_GALAXY|AMBER_GALAXY)\\b"
    },
    "algorithms": {
      "name": "support.function.algorithm.akkadian",
      "match": "\\b(levenshtein|h3|hnsw|kd_tree|cosine|euclidean|manhattan|jaro_winkler|soundex|metaphone)\\b"
    },
    "literals": {
      "patterns": [
        {
          "name": "string.quoted.double.akkadian",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.akkadian", "match": "\\\\." }
          ]
        },
        {
          "name": "constant.numeric.float.akkadian",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.akkadian",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.language.boolean.akkadian",
          "match": "\\b(true|false|TRUE|FALSE|null|NULL)\\b"
        },
        {
          "name": "constant.language.color.akkadian",
          "match": "#[0-9A-Fa-f]{6}\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.akkadian",
          "match": ":(?!=)"
        },
        {
          "name": "punctuation.definition.block.akkadian",
          "match": "[{}\\[\\]()]"
        },
        {
          "name": "punctuation.separator.akkadian",
          "match": "[,;]"
        },
        {
          "name": "keyword.operator.comparison.akkadian",
          "match": "(>=|<=|!=|==|>|<)"
        }
      ]
    },
    "identifiers": {
      "name": "variable.other.akkadian",
      "match": "\\b[a-z][a-z0-9_]*\\b"
    }
  }
}
