# ═══════════════════════════════════════════════════════════════
#  EriduuOS v4.0 Stack — Environment Variables
#  Copy to .env and fill in your values before running
#  cp .env.example .env && nano .env
# ═══════════════════════════════════════════════════════════════

# ── Host Settings ────────────────────────────────────────────────
HOST_IP=172.22.187.100
BASE_DOMAIN=eriduu.local

# ── PostgreSQL (shared by multiple services) ─────────────────────
POSTGRES_USER=eriduu_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=eriduu_main

# ── Vaultwarden (Password Manager) ───────────────────────────────
VAULTWARDEN_ADMIN_TOKEN=change_me_random_token_here
VAULTWARDEN_DOMAIN=https://vault.eriduu.local

# ── Gitea (Self-hosted Git) ───────────────────────────────────────
GITEA_DB_NAME=gitea
GITEA_ADMIN_USER=bahaa
GITEA_ADMIN_PASSWORD=change_me
GITEA_ADMIN_EMAIL=bahaa.fadam@gmail.com

# ── Plausible Analytics ───────────────────────────────────────────
PLAUSIBLE_SECRET_KEY_BASE=change_me_64_char_random_string
PLAUSIBLE_ADMIN_EMAIL=bahaa.fadam@gmail.com
PLAUSIBLE_ADMIN_PASSWORD=change_me

# ── AppFlowy ──────────────────────────────────────────────────────
APPFLOWY_GOTRUE_JWT_SECRET=change_me_random_jwt_secret
APPFLOWY_ADMIN_EMAIL=bahaa.fadam@gmail.com
APPFLOWY_ADMIN_PASSWORD=change_me

# ── n8n (Workflow Automation / AAOL bridge) ───────────────────────
N8N_BASIC_AUTH_USER=bahaa
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_ENCRYPTION_KEY=change_me_random_32_char_key

# ── Woodpecker CI ─────────────────────────────────────────────────
WOODPECKER_ADMIN=bahaa
WOODPECKER_HOST=http://172.22.187.100:8050
WOODPECKER_GITEA_URL=http://172.22.187.100:3300
WOODPECKER_GITEA_CLIENT=change_me_gitea_oauth_client
WOODPECKER_GITEA_SECRET=change_me_gitea_oauth_secret
WOODPECKER_AGENT_SECRET=change_me_agent_secret

# ── Cal.com ───────────────────────────────────────────────────────
CAL_NEXTAUTH_SECRET=change_me
CAL_CALENDSO_ENCRYPTION_KEY=change_me_32_char_key
CAL_DATABASE_URL=postgresql://eriduu_admin:change_me@postgres:5432/calcom

# ── Penpot ────────────────────────────────────────────────────────
PENPOT_SECRET_KEY=change_me
PENPOT_PUBLIC_URI=http://172.22.187.100:9001

# ── CrowdSec (WAY Language security backend) ─────────────────────
CROWDSEC_BOUNCER_API_KEY=change_me

# ── Traefik ───────────────────────────────────────────────────────
TRAEFIK_ACME_EMAIL=bahaa.fadam@gmail.com
