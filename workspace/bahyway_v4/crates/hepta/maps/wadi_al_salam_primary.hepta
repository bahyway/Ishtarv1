@HEPTA_VERSION 3.5.1
@COORDINATE_SYSTEM KAKI_7D_SACRED
@PROJECT_ID "NajafWay_Wadi_Al_Salam"

# ============================================================================
# wadi_al_salam_primary.hepta
# BahyWay.Ecosystem — Wadi al-Salam Sovereign Spatial Index
#
# Wadi al-Salam (Valley of Peace), Najaf, Iraq
# One of the largest cemeteries on Earth: ~6 million souls, 1400+ years,
# ~900 hectares of dense irregular burial terrain.
#
# WHY HEPTA DEFEATS OSM/H3/LEAFLET HERE:
#   - Paths are 50–60 cm wide: Valhalla minimum is 2 m. Hepta has no minimum.
#   - No street addresses: Hepta uses Landmark Vectors from the 7 planet-nodes.
#   - Vertical complexity: 2–5 metre high vault towers, underground chambers.
#     Hepta D3 (elevation) and D7 (density) encode this. Leaflet is 2D only.
#   - 6M entities need recursive zoom: Hepta Hobble-Zoom gives 8^n sub-cells.
#   - Sacred geometry alignment: the 7 planet-nodes map to the 7 heavens
#     of Islamic cosmology, building trust with pilgrims and clergy.
#
# Anchor: Shrine of Imam Ali (AS) — the Sun / Utu — origin of all beams.
# Radius: 2km — covers the full perimeter of Wadi al-Salam.
# ============================================================================

# ─── ORIGIN ──────────────────────────────────────────────────────────────────
# The Shrine of Imam Ali (AS) is the cosmological Sun of this heptagram.
# Every chord, every path, every KAKI PK ultimately resolves back to this point.

ANCHOR [H7-00:SUN] {
    identity: "Imam_Ali_Shrine_AS",
    center: {lat: 31.9957, lon: 44.3148},
    radius: 2km,
    rotation: 51.42deg,
    kaki_pk_base: 0x00007D4E414A4146000000,
    sacred_weight: 1.0
}

# ─── SECTOR 1: MOON/NANNA — MAQAM AL-MAHDI ───────────────────────────────────
# The Northern Light — represents the future direction of cemetery expansion.
# Pilgrimage volume: seasonal spikes during Shaban and Muharram.

SECTOR [H7-01:MOON] {
    identity: "Maqam_Al_Mahdi_AJ",
    kaki_pk: 0x01007D4E414A4146000000,
    relative_to: [H7-00:SUN],

    PATH [CHORD-7/2] -> [H7-03:VENUS] {
        type: PEDESTRIAN_ONLY,
        passability: NARROW,
        latency: 8ms
    }

    ATTRIB [grave:density]        = MEDIUM
    ATTRIB [navigation:difficulty] = LOW
    ATTRIB [pilgrimage:volume]    = HIGH
    ATTRIB [expansion:zone]       = true
    ATTRIB [enki:sector_id]       = "H7-NAJAF-MOON-01"
}

# ─── SECTOR 2: MERCURY/ENKI — SHRINE OF PROPHET HUD & SALIH ─────────────────
# The Ancient Knowledge — oldest historical core of the cemetery.
# Graves here date to the pre-Islamic period. Extremely dense, irregular paths.
# This sector is the primary test of Hepta's hyperbolic density model.

SECTOR [H7-02:MERCURY] {
    identity: "Prophet_Hud_Salih_Shrine",
    kaki_pk: 0x02007D4E414A4146000000,
    relative_to: [H7-00:SUN],

    chord_link: {
        target: [H7-06:SATURN],
        type: "BEAM_ANCIENT_PATH"
    }

    PATH [CHORD-7/2] -> [H7-04:MARS] {
        type: PEDESTRIAN_ONLY,
        passability: VERY_NARROW,
        historical_status: PROTECTED,
        hidden_path_probability: 0.88
    }

    ATTRIB [grave:density]        = VERY_HIGH
    ATTRIB [grave:style]          = "Ancient_Pre_Islamic"
    ATTRIB [navigation:difficulty] = EXTREME
    ATTRIB [infrastructure:water] = UNKNOWN
    ATTRIB [discovery:mode]       = PARTICLE_FLOW_INFERENCE
}

# ─── SECTOR 3: VENUS/INANNA — TOMB OF GRAND AYATOLLAH AL-SADR ───────────────
# The Path of Sacrifice — modern landmark, high-volume visitation.
# This is the most-requested navigation target in NajafWay.

SECTOR [H7-03:VENUS] {
    identity: "Tomb_Grand_Ayatollah_Al_Sadr",
    kaki_pk: 0x03007D4E414A4146000000,
    relative_to: [H7-00:SUN],

    PATH [CHORD-7/2] -> [H7-05:JUPITER] {
        type: PEDESTRIAN_ONLY,
        passability: WIDE,
        latency: 6ms
    }

    PATH [CHORD-7/3] -> [H7-06:SATURN] {
        type: PEDESTRIAN_ONLY,
        passability: STANDARD,
        hidden_path_probability: 0.79
    }

    ATTRIB [grave:density]        = HIGH
    ATTRIB [navigation:difficulty] = MEDIUM
    ATTRIB [pilgrimage:volume]    = VERY_HIGH
    ATTRIB [storyway:enabled]     = true
    ATTRIB [vault:access_level]   = PUBLIC
}

# ─── SECTOR 4: MARS/NERGAL — THE MARTYRS' SECTOR ─────────────────────────────
# The Gate of Resilience — sections dedicated to those lost in conflict.
# Contains graves from the Iran-Iraq war, Gulf War, and post-2003 period.
# High rate of new additions; infrastructure under continuous pressure.

SECTOR [H7-04:MARS] {
    identity: "Martyrs_Sector_War_Period",
    kaki_pk: 0x04007D4E414A4146000000,
    relative_to: [H7-00:SUN],

    condition: "ACTIVE_EXPANSION"

    PATH [CHORD-7/2] -> [H7-06:SATURN] {
        type: PEDESTRIAN_ONLY,
        passability: STANDARD,
        status: INFRASTRUCTURE_RECOVERY,
        hidden_path_probability: 0.71
    }

    ATTRIB [grave:density]        = HIGH
    ATTRIB [grave:condition]      = "Recent_Active"
    ATTRIB [navigation:difficulty] = MEDIUM
    ATTRIB [vault:access_level]   = RESTRICTED
    ATTRIB [storyway:enabled]     = true
    ATTRIB [enki:sector_id]       = "H7-NAJAF-MARS-04"
}

# ─── SECTOR 5: JUPITER/ENLIL — KINGS & SULTANS SECTOR ───────────────────────
# The Historical Vault — where the Al-Hira and royal dynasties are interred.
# Irregular vault architecture, some structures 8–12 metres tall.
# Primary use case for D3 (elevation) encoding in KAKI_7D.

SECTOR [H7-05:JUPITER] {
    identity: "Kings_Sultans_Al_Hira_Sector",
    kaki_pk: 0x05007D4E414A4146000000,
    relative_to: [H7-00:SUN],

    PATH [CHORD-7/2] -> [H7-00:SUN] {
        type: PEDESTRIAN_ONLY,
        passability: NARROW,
        historical_status: PROTECTED,
        latency: 11ms
    }

    ATTRIB [grave:density]        = MEDIUM
    ATTRIB [grave:style]          = "Multi_Level_Vault"
    ATTRIB [navigation:difficulty] = HIGH
    ATTRIB [heritage:protected]   = true
    ATTRIB [vault:access_level]   = HERITAGE_CURATOR
    ATTRIB [storyway:enabled]     = true
    ATTRIB [enki:sector_id]       = "H7-NAJAF-JUPITER-05"
}

# ─── SECTOR 6: SATURN/NINURTA — ANCIENT DESTRUCTIVE GRAVES ──────────────────
# The Stability of Memory — the most difficult unmapped zone.
# Graves here are partially destroyed by weather, neglect, and construction.
# This is where Hepta's HIDDEN_PATH inference is most critical.
# ParticlesWay erosion simulation + BeamMeWay chord inference together
# reconstruct probable grave locations from surrounding geometry.

SECTOR [H7-06:SATURN] {
    identity: "Ancient_Destructive_Sector",
    kaki_pk: 0x06007D4E414A4146000000,
    relative_to: [H7-00:SUN],

    condition: "HIGH_DENSITY_RUINS"

    # BeamMeWay uses hidden_path_probability to infer path existence
    # even when no physical path is visible from above.
    BEAM [CHORD-7/3] -> [H7-03:VENUS] {
        status: INFRASTRUCTURE_RECOVERY,
        hidden_path_probability: 0.92,
        type: PEDESTRIAN_ONLY,
        passability: INFERRED
    }

    BEAM [CHORD-7/2] -> [H7-01:MOON] {
        status: INFRASTRUCTURE_RECOVERY,
        hidden_path_probability: 0.83,
        type: PEDESTRIAN_ONLY
    }

    ATTRIB [grave:density]        = EXTREME
    ATTRIB [grave:condition]      = "Old_Destructive"
    ATTRIB [navigation:difficulty] = EXTREME
    ATTRIB [discovery:mode]       = PARTICLE_FLOW_INFERENCE
    ATTRIB [infrastructure:water] = PROBABLE_HIDDEN
    ATTRIB [vault:access_level]   = DATA_STEWARD_ONLY
    ATTRIB [storyway:enabled]     = true
    ATTRIB [search:method]        = "Relative_Discovery"
}

# ─── SAMPLE FAMILY VAULT CLUSTER ─────────────────────────────────────────────
# A NODE block represents a single fine-grained point within a sector.
# This is what the Hobble-Zoom resolves to after 2 levels of recursion.
# The StoryWay layer is triggered when a user's KAKI_7D PK matches this node.

NODE [H7-06:SATURN] {
    identity: "Family_Vault_Al_Bahy_Example",
    kaki_pk: 0x06017D4E414A4146000001,
    relative_to: [H7-06:SATURN],

    PATH [CHORD-7/2] -> [H7-05:JUPITER] {
        type: PEDESTRIAN_ONLY,
        passability: NARROW,
        historical_status: PROTECTED
    }

    ATTRIB [grave:occupant_count] = 12
    ATTRIB [grave:style]          = "Baked_Brick_Tower"
    ATTRIB [grave:condition]      = "Old_Destructive"
    ATTRIB [family:cluster_id]    = "VAULT-AL-BAHY-001"
    ATTRIB [storyway:record_id]   = "SW-NAJAF-0012944"
    ATTRIB [vault:access_level]   = FAMILY_KEY
    ATTRIB [navigation:search]    = "Relative_Discovery"
}
