# =============================================================================
# enkidw-write-server — EnkiDW (Data Warehouse) Write Node container image.
#
# Build (from the repo root):
#   podman build -t enkidw-write-server:latest \
#     -f deploy/podman/Containerfile.enkidw-write-server \
#     workspace/bahyway_v4
#
# Run:
#   podman run -d --name enkidw-write \
#     -p 7012:7012 \
#     -v enkidw-landing:/data/dw/landing:Z \
#     -v enkidw-persist:/data/dw/persist:Z \
#     -v enkidw-data:/data/dw:Z \
#     --restart=always \
#     enkidw-write-server:latest
#
# Three volumes: the landing zone (files land here), PersistedDb's own
# crash-safe disk journal (EnkiDW's real durability boundary --
# `enkidb_persist::disk_journal`, its own binary format, never JSON), and
# the materialized Data Files `enkidw-read-server` serves from.
#
# `:Z` on every volume mount is required on Fedora/SELinux-enforcing hosts
# (matches this fleet's existing convention).
# =============================================================================
FROM docker.io/library/rust:1-slim AS builder
WORKDIR /build
COPY . .
RUN cargo build --release -p enkidw-write-server

FROM registry.fedoraproject.org/fedora-minimal:latest
RUN microdnf install -y shadow-utils && microdnf clean all \
    && useradd --system --home-dir /data --create-home enkidw
COPY --from=builder /build/target/release/enkidw-write-server /usr/local/bin/enkidw-write-server
USER enkidw
WORKDIR /data
ENV BIND_ADDR=0.0.0.0:7012
ENV LANDING_DIR=/data/dw/landing
ENV PERSIST_DIR=/data/dw/persist
ENV DATA_DIR=/data/dw
EXPOSE 7012
ENTRYPOINT ["/usr/local/bin/enkidw-write-server"]
