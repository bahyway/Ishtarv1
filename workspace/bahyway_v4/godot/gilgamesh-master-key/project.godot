; Gilgamesh Master Key -- BahyWay.Ecosystem v4.0
; 2026-07-23
;
; Standalone tool for the Architect Key ceremony (see kupru's
; ARCHITECT_KEY_CEREMONY.md): generate the root Ed25519 keypair, split
; it into M-of-N Shamir shares for distribution across genuinely
; different failure domains, reconstruct from gathered shares during a
; real break-glass event, and mint a fresh architect-privilege
; SargonPassport from the reconstructed key. Uses kupru-gdext's real
; crypto -- never a single unsplit master key sitting on disk.
;
; The compiled bridge library is expected at res://bin/libkupru_gdext.so
; (Linux) -- see kupru.gdextension. Built and copied here by
; playbooks/playbook_227_build_kupru_tools.yml, not committed as a
; binary artifact.

config_version=5

[application]

config/name="BahyWay.Ecosystem v4.0 -- Gilgamesh Master Key"
config/description="Architect Key ceremony tool: Shamir M-of-N split/reconstruct and architect passport minting."
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.0392157, 0.0549020, 0.1019608, 1)

[display]

; FIXED 2026-08-02: same missing-[display]-section bug as sargon-
; passport-manager's project.godot (see that file's comment) -- ran at
; Godot's small default window size (1152x648) with no way to resize.
;
; ENLARGED 2026-08-02, live: 1280x900 was still reported too small on
; real hardware. window/size/mode=2 (Maximized) uses all available
; screen space on launch regardless of monitor size; viewport_width/
; height stay as the windowed-mode fallback if ever un-maximized.
window/size/viewport_width=1280
window/size/viewport_height=900
window/size/mode=2

; FIXED 2026-08-02, live: mode=2 alone (window/size/mode above) does NOT
; scale the UI -- confirmed live, text still tiny on a maximized window.
; canvas_items stretch scales the whole UI to fill the actual window
; size using viewport_width/height as the reference resolution -- see
; sargon-passport-manager/project.godot's comment for the full reasoning.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
