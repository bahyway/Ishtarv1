; DubSar PDM (Particle Data Modeling) -- BahyWay.Ecosystem v4.0
; 2026-07-24
;
; Standalone app: DubSar PDM, the Simplicial Complex + GA workspace,
; launched independently alongside DubSar IDE -- same "two apps, like
; Sargon/Gilgamesh" pattern already proven for the kupru tools.
;
; Login reuses DubSar's real sovereign Passport gate (kupru-gdext's
; KupruBridge) -- same mandatory login as DubSar IDE, not a lighter
; substitute, since this app is a Passport *consumer* the same way.
;
; The math itself is NOT reimplemented here -- pdm-gdext (see
; pdm.gdextension) wraps bahyway-algebra::topology's 20 canonical
; operators (115 passing tests) and najaf-engine::topology's
; simplicial-complex machinery directly.
;
; Both compiled bridge libraries are expected at res://bin/ (Linux) --
; built and copied by a future playbook, not committed as binary
; artifacts, matching kupru-gdext's own precedent.

config_version=5

[application]

config/name="BahyWay.Ecosystem v4.0 -- DubSar PDM"
config/description="Sovereign Particle Data Modeling: Simplicial Complex + Geometric Algebra workspace."
run/main_scene="res://scenes/login.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.0980392, 0.207843, 0.286275, 1)

[rendering]

renderer/rendering_method="forward_plus"
