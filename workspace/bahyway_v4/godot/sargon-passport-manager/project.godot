; Sargon Passport Manager -- BahyWay.Ecosystem v4.0
; 2026-07-23
;
; Standalone tool: generate, encrypt-at-rest, verify, and renew
; SargonPassport credentials using kupru's REAL crypto (Argon2id,
; Ed25519, ChaCha20-Poly1305) via the kupru-gdext bridge -- not the
; AkkadiSafeBridge.gd stub the main DubSar Theater IDE still uses.
;
; The compiled bridge library is expected at res://bin/libkupru_gdext.so
; (Linux) -- see kupru.gdextension. Built and copied here by
; playbooks/playbook_227_build_kupru_tools.yml, not committed as a
; binary artifact.

config_version=5

[application]

config/name="BahyWay.Ecosystem v4.0 -- Sargon Passport Manager"
config/description="Standalone vault for generating, verifying, and renewing SargonPassport credentials with kupru's real cryptography."
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.0392157, 0.0549020, 0.1019608, 1)

[display]

; FIXED 2026-08-02, live: no [display] section existed, so this ran at
; Godot's small default window size (1152x648) -- the vault-entries
; list plus the issue-new-passport form overflowed it, cutting text off
; on the right edge with no way to resize/scroll. Same bug + same fix
; dubsar-theater's project.godot already documents for its own window.
;
; ENLARGED 2026-08-02, live: 1280x900 was still reported too small on
; real hardware to read comfortably. window/size/mode=2 (Maximized)
; makes the window use all available screen space on launch, on any
; monitor size, rather than guessing a fixed pixel size that's either
; too small on a big screen or overflows a small one; viewport_width/
; height stay as the windowed-mode fallback size if ever un-maximized.
window/size/viewport_width=1280
window/size/viewport_height=900
window/size/mode=2

; FIXED 2026-08-02, live: maximizing the window (mode=2 above) did NOT
; make the text bigger -- confirmed live, still "very very small" on a
; full-screen window. Root cause: Godot's UI does not scale with window
; size by default; without a stretch mode, a bigger window just means
; more empty space around the SAME fixed-pixel font sizes, not bigger
; text. stretch/mode=canvas_items scales the whole 2D UI (fonts,
; buttons, everything) to fill however big the actual window/viewport
; is, using viewport_width/height above as the reference resolution --
; this is the setting that actually makes "bigger window" mean "bigger
; text," which mode=2 alone never did.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
