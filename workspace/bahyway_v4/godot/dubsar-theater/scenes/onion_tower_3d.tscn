; 2026-07-21: Onion Layers 3D Tower -- minimal scene, all nodes (Camera3D,
; WorldEnvironment, lighting, ring meshes, pick areas, UI overlay) are
; built in scripts/onion_tower_3d.gd's _ready(), matching the same
; code-builds-everything convention already used by dashboard_theater.tscn,
; document_explorer.tscn and pdm_tab.gd's own sub-tabs -- avoids hand-
; authoring a complex 3D .tscn with many sub_resources.

[gd_scene load_steps=2 format=3 uid="uid://onion_tower_3d_main"]

[ext_resource type="Script" path="res://scripts/onion_tower_3d.gd" id="1"]

[node name="OnionTower3D" type="Node3D"]
script = ExtResource("1")
