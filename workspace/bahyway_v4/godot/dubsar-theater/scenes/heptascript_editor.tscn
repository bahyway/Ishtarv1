; 2026-07-21: restyled onto DubSarTheme (scripts/dubsar_theme.gd) -- the
; literal Colors below are that file's BG/TEXT_PRIMARY/TEXT_DIM converted
; to float RGB (.tscn sub_resources can't reference a GDScript const
; directly). heptascript_editor.gd's own syntax highlighter and
; pdm_tab.gd's own C_* palette were restyled the same way, in their own
; files (see those files' own headers).

[gd_scene load_steps=8 format=3 uid="uid://heptascript_editor_main"]

[ext_resource type="Script" path="res://scripts/heptascript_editor.gd" id="1"]
[ext_resource type="Script" path="res://scripts/pdm_tab.gd" id="2"]
[ext_resource type="Script" path="res://scripts/navi_translate_tab.gd" id="3"]
[ext_resource type="Script" path="res://scripts/engine_map_tab.gd" id="4"]
[ext_resource type="Script" path="res://scripts/grid_marduk_tab.gd" id="5"]
[ext_resource type="Script" path="res://scripts/glossary_tab.gd" id="6"]

[sub_resource type="StyleBoxFlat" id="log_bg"]
bg_color = Color(0.0392, 0.0549, 0.1020, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_left = 4
corner_radius_bottom_right = 4

[node name="HeptaScriptEditor" type="Control"]
layout_mode = 3
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -480.0
offset_top = -340.0
offset_right = 480.0
offset_bottom = 340.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.9098, 0.9176, 0.9412, 1)
text = "𒁾  HeptaScript Editor"

[node name="Toolbar" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="HostLabel" type="Label" parent="MarginContainer/VBoxContainer/Toolbar"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.5451, 0.5765, 0.6549, 1)
text = "HOST"

[node name="HostInput" type="LineEdit" parent="MarginContainer/VBoxContainer/Toolbar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 0)
layout_mode = 2
text = "192.168.122.107"

[node name="VSep1" type="VSeparator" parent="MarginContainer/VBoxContainer/Toolbar"]
layout_mode = 2

[node name="NodeTargetsBox" type="HBoxContainer" parent="MarginContainer/VBoxContainer/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
