theme_override_constants/separation = 8

[node name="VSep2" type="VSeparator" parent="MarginContainer/VBoxContainer/Toolbar"]
layout_mode = 2

[node name="PolicyOption" type="OptionButton" parent="MarginContainer/VBoxContainer/Toolbar"]
