; 2026-07-21: restyled onto DubSarTheme (scripts/dubsar_theme.gd) --
; every literal Color(...) below is that file's palette converted to
; float RGB (.tscn sub_resources can't reference a GDScript const
; directly), not a fresh set of colors invented for this scene:
;   header_bg/footer_bg bg_color    -> DubSarTheme.BG_ELEVATED
;   step_dot_active bg_color        -> DubSarTheme.ACCENT_CYAN (was
;                                       crimson, #e94560 -- the wizard's
;                                       own step indicator isn't an error
;                                       state, so it now matches the same
;                                       cyan the reference dashboards use
;                                       for "active")
;   step_dot_pending / border_color -> DubSarTheme.BORDER
;   theme_override_colors/font_color literals below map to TEXT_PRIMARY
;   (0.918,0.918,0.918 -> 0.9098,0.9176,0.9412) or TEXT_DIM
;   (0.627,0.627,0.722 -> 0.5451,0.5765,0.6549); the one teal accent
;   (0.0,0.851,0.647) maps to ACCENT_GREEN.

[gd_scene load_steps=12 format=3 uid="uid://wizard_main_v2"]

[ext_resource type="Script" path="res://scripts/wizard.gd" id="1_wizard"]
[ext_resource type="Script" path="res://scripts/page1_db_selection.gd" id="2_page1"]
[ext_resource type="Script" path="res://scripts/page2_connection.gd" id="3_page2"]
[ext_resource type="Script" path="res://scripts/page3_credentials.gd" id="4_page3"]
[ext_resource type="Script" path="res://scripts/page4_summary.gd" id="5_page4"]
[ext_resource type="Script" path="res://scripts/credentials_popup.gd" id="6_creds"]
[ext_resource type="Script" path="res://scripts/test_popup.gd" id="7_test"]

; 2026-07-21: restyled onto DubSarTheme (scripts/dubsar_theme.gd) --
; every literal Color(...) below is that file's palette converted to
; float RGB (.tscn sub_resources can't reference a GDScript const
; directly), not a fresh set of colors invented for this scene:
;   header_bg/footer_bg bg_color  -> DubSarTheme.BG_ELEVATED
;   step_dot_active bg_color      -> DubSarTheme.ACCENT_CYAN (was crimson,
;                                     #e94560 -- the wizard's own step
;                                     indicator isn't an error state, so
;                                     it now matches the same cyan the
;                                     reference dashboards use for "active")
;   step_dot_pending / border_color -> DubSarTheme.BORDER
;   theme_override_colors/font_color literals elsewhere in this file map
;   to TEXT_PRIMARY (0.918,0.918,0.918 -> 0.9098,0.9176,0.9412) or
;   TEXT_DIM (0.627,0.627,0.722 -> 0.5451,0.5765,0.6549); the one teal
;   accent (0.0,0.851,0.647) maps to ACCENT_GREEN.
[sub_resource type="StyleBoxFlat" id="header_bg"]
bg_color = Color(0.0510, 0.0706, 0.1255, 1)
corner_radius_top_left = 16
corner_radius_top_right = 16

[sub_resource type="StyleBoxFlat" id="step_dot_active"]
bg_color = Color(0.1333, 0.8275, 0.9333, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_left = 2
corner_radius_bottom_right = 2

[sub_resource type="StyleBoxFlat" id="step_dot_pending"]
bg_color = Color(0.1294, 0.1608, 0.2510, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_left = 2
corner_radius_bottom_right = 2

[sub_resource type="StyleBoxFlat" id="footer_bg"]
bg_color = Color(0.0510, 0.0706, 0.1255, 1)
border_width_top = 1
border_color = Color(0.1294, 0.1608, 0.2510, 1)
corner_radius_bottom_left = 16
corner_radius_bottom_right = 16

[node name="Wizard" type="Control"]
layout_mode = 3
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -350.0
offset_right = 360.0
offset_bottom = 350.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_wizard")

[node name="MarginContainer" type="MarginContainer" parent="."]
