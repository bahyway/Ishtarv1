; ── Crown ────────────────────────────────────────────────────────────────────
[node name="Crown" type="Node3D" parent="."]
transform = Transform3D(1,0,0, 0,1,0, 0,0,1, 0, 0.72, 0)

[node name="CrownPivot" type="Node3D" parent="Crown"]

[node name="CrownRing" type="MeshInstance3D" parent="Crown/CrownPivot"]
