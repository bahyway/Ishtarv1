; ── Animation player ─────────────────────────────────────────────────────────
[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
; Animations added in Godot editor:
;   nisaba_idle        — gentle breathing/sway
;   nisaba_discovery   — excited vibration
;   nisaba_proposal    — lean forward slightly
;   nisaba_teaching    — arm gesture outward
;   nisaba_sealing     — arms raise + gold flash
