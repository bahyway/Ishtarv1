; DubSar Login — mandatory entry gate, now with the BIGRING particle ring
; as a live backdrop instead of a flat background color.
; DUB.SAR 𒁾  2026-07-23
;
; Root changed from PanelContainer to Node3D so CENTER_STAGE (the same
; real BIGRING GPUParticles3D setup main_theater.tscn's own CENTER_STAGE
; uses -- see that scene's own header) can render behind the login card.
; The login card itself (built entirely in code by login.gd's _build_ui)
; is a Control added as a child of this Node3D root -- the exact same
; "2D UI layered under a 3D root" pattern already proven working by
; main_theater.tscn's own EnkiDbWizard (scenes/wizard.tscn, root type
; Control, instanced directly under DubSarTheater's Node3D root).

[gd_scene load_steps=3 format=3 uid="uid://dubsar_login_main"]

[ext_resource type="Script" path="res://scripts/login.gd" id="1"]

[sub_resource type="ParticleProcessMaterial" id="bigring_mat"]
emission_shape = 2
emission_sphere_radius = 3.0
direction = Vector3(0, 1, 0)
spread = 180.0
gravity = Vector3(0, 0, 0)
initial_velocity_min = 0.5
initial_velocity_max = 2.0
angular_velocity_min = -45.0
angular_velocity_max = 45.0
color = Color(0.118, 0.627, 0.459, 1)

[node name="DubSarLogin" type="Node3D"]
script = ExtResource("1")

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.9659, 0.2588, 0, -0.2588, 0.9659, 0, 2.0, 6.0)
current = true
fov = 70.0

[node name="CENTER_STAGE" type="GPUParticles3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, -1.0)
amount = 50000
lifetime = 4.0
process_material = SubResource("bigring_mat")
visibility_aabb = AABB(-5, -5, -5, 10, 10, 10)

[node name="TheaterLight" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.866025, 0.5, 0, -0.5, 0.866025, 0, 5, 0)
light_energy = 0.6
light_color = Color(0.831, 0.686, 0.216, 1)

[node name="AmbientFill" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 3, 3)
light_color = Color(0.114, 0.62, 0.459, 1)
light_energy = 0.3
omni_range = 12.0
