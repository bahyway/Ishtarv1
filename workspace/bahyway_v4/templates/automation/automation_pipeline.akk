-- BahyWay.Ecosystem v4.0 — Automation Pillar
-- Sovereign Pipeline: routes multi-file batches to per-type templates.
--
-- When bee-watchdog finds this file at:
--   shard/profiles/{batch_name}.pipeline.akk
-- it loads each stage's template from:
--   shard/profiles/{StageName}.template.akk
-- and routes archive entries by filename substring match (case-insensitive):
--   "…task…"     → AutomationTask.template.akk
--   "…schedule…" → AutomationSchedule.template.akk
--   "…log…"      → AutomationLog.template.akk
-- No match → default template (auto-inferred from data)

PIPELINE AutomationPillar v4 {
    AutomationTask
    AutomationSchedule
    AutomationLog
}
