# =============================================================================
# enkiddb-read-server — EnkiDDB (Tigris) Read Node container image.
#
# Build (from the repo root):
#   podman build -t enkiddb-read-server:latest \
#     -f deploy/podman/Containerfile.read-server \
#     workspace/bahyway_v4
#
# Run:
#   podman run -d --name enkiddb-read \
#     -p 7102:7102 \
#     -v enkiddb-read-data:/data:Z \
#     -e RELOAD_SECS=30 \
#     --restart=always \
#     enkiddb-read-server:latest
#
# Lifecycle (no systemd anywhere -- plain Podman commands):
#   podman stop enkiddb-read
#   podman start enkiddb-read
#   podman logs -f enkiddb-read
#
# Data path: this container never writes -- it only opens
# /data/current/{entities,eav} read-only and reloads on a timer. Getting
# the Write Node's materialized data into that path is a separate step;
# see scripts/enkiddb-sync-data.sh (run on enkidb-node-write, not
# containerized -- see that script's header for why).
#
# `:Z` on the volume mount is required on Fedora/SELinux-enforcing hosts.
# =============================================================================
FROM docker.io/library/rust:1-slim AS builder
WORKDIR /build
COPY . .
RUN cargo build --release -p enkiddb-read-server

FROM registry.fedoraproject.org/fedora-minimal:latest
RUN microdnf install -y shadow-utils && microdnf clean all \
    && useradd --system --home-dir /data --create-home enkiddb
COPY --from=builder /build/target/release/enkiddb-read-server /usr/local/bin/enkiddb-read-server
USER enkiddb
WORKDIR /data
ENV BIND_ADDR=0.0.0.0:7102
ENV DATA_DIR=/data
EXPOSE 7102
ENTRYPOINT ["/usr/local/bin/enkiddb-read-server"]
