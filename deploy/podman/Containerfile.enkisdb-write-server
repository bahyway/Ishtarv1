# =============================================================================
# enkisdb-write-server — EnkiSDB Stage pipeline daemon container image.
#
# This ONE process owns the whole real staging pipeline, not just EnkiSDB:
# it also drains Promoted/Quarantined particles into EnkiODB/EnkiQDB
# in-process (see the crate's own module doc — `OdbStore::drain_from_sdb`
# and `QdbStore::drain_from_sdb` take `&SdbStore` by reference, an
# in-process borrow, not a network call). It materializes THREE separate
# Data File trees under one /data volume: sdb, odb, qdb -- each has its
# own independent Read Node (enkisdb-read-server, enkiodb-read-server,
# enkiqdb-read-server) that must be synced separately. There is
# deliberately no enkiodb-write-server / enkiqdb-write-server image --
# that would duplicate this pipeline's already-designed shape.
#
# Build (from the repo root):
#   podman build -t enkisdb-write-server:latest \
#     -f deploy/podman/Containerfile.enkisdb-write-server \
#     workspace/bahyway_v4
#
# Run:
#   podman run -d --name enkisdb-write \
#     -p 7013:7013 \
#     -v enkisdb-write-data:/data:Z \
#     -e TRIBE_ID=0x7003 \
#     --restart=always \
#     enkisdb-write-server:latest
#
# Landing zone: drop files under LANDING_DIR (default /data/sdb/landing,
# inside the same /data volume) to feed the Stage pipeline.
#
# Lifecycle (no systemd anywhere -- plain Podman commands):
#   podman stop enkisdb-write
#   podman start enkisdb-write
#   podman logs -f enkisdb-write
#
# Backup: the volume (enkisdb-write-data), not the container, is what
# holds state for all three stages -- back up its mounted directory
# directly rather than `podman commit`.
#
# `:Z` on the volume mount is required on Fedora/SELinux-enforcing hosts.
# =============================================================================
FROM docker.io/library/rust:1-slim AS builder
WORKDIR /build
COPY . .
RUN cargo build --release -p enkisdb-write-server

FROM registry.fedoraproject.org/fedora-minimal:latest
RUN microdnf install -y shadow-utils && microdnf clean all \
    && useradd --system --home-dir /data --create-home enkisdb
COPY --from=builder /build/target/release/enkisdb-write-server /usr/local/bin/enkisdb-write-server
USER enkisdb
WORKDIR /data
ENV BIND_ADDR=0.0.0.0:7013
ENV LANDING_DIR=/data/sdb/landing
ENV SDB_DATA_DIR=/data/sdb
ENV ODB_DATA_DIR=/data/odb
ENV QDB_DATA_DIR=/data/qdb
EXPOSE 7013
ENTRYPOINT ["/usr/local/bin/enkisdb-write-server"]
