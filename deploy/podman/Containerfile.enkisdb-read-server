# =============================================================================
# enkisdb-read-server — EnkiSDB (Stage) Read Node container image.
#
# Build (from the repo root):
#   podman build -t enkisdb-read-server:latest \
#     -f deploy/podman/Containerfile.enkisdb-read-server \
#     workspace/bahyway_v4
#
# Run:
#   podman run -d --name enkisdb-read \
#     -p 7003:7003 \
#     -v enkisdb-read-data:/data:Z \
#     -e RELOAD_SECS=30 \
#     --restart=always \
#     enkisdb-read-server:latest
#
# Lifecycle (no systemd anywhere -- plain Podman commands):
#   podman stop enkisdb-read
#   podman start enkisdb-read
#   podman logs -f enkisdb-read
#
# Data path: this container never writes -- it only opens
# /data/current/{entities,eav} read-only and reloads on a timer. Getting
# the Write Node's materialized sdb/ tree into that path is a separate
# step; see scripts/enkisdb-sync-data.sh.
#
# `:Z` on the volume mount is required on Fedora/SELinux-enforcing hosts.
# =============================================================================
FROM docker.io/library/rust:1-slim AS builder
WORKDIR /build
COPY . .
RUN cargo build --release -p enkisdb-read-server

FROM registry.fedoraproject.org/fedora-minimal:latest
RUN microdnf install -y shadow-utils && microdnf clean all \
    && useradd --system --home-dir /data --create-home enkisdb
COPY --from=builder /build/target/release/enkisdb-read-server /usr/local/bin/enkisdb-read-server
USER enkisdb
WORKDIR /data
ENV BIND_ADDR=0.0.0.0:7003
ENV DATA_DIR=/data
EXPOSE 7003
ENTRYPOINT ["/usr/local/bin/enkisdb-read-server"]
