{
  "assets_node_version": {{ assets_node_version }},
  "built_at": "{{ built_at }}",
  "built_from_commit": "{{ built_from_commit }}",
  "supersedes": {{ supersedes | to_json }},
  "contents": [
    {
      "name": "rust-toolchain",
      "path": "/assets/rust-toolchain",
      "version": "1.94.1",
      "source": "https://sh.rustup.rs",
      "note": "profile=minimal."
    },
    {
      "name": "vendored-crates",
      "path": "/assets/vendor",
      "crate_count": {{ crate_count }},
      "source": "cargo vendor --locked, from workspace/bahyway_v4/Cargo.lock",
      "note": "Re-run cargo vendor and bump assets_node_version whenever Cargo.lock changes -- this snapshot does not auto-refresh."
    },
    {
      "name": "godot-engine",
      "path": "/assets/bin/godot4",
      "version": "4.3-stable",
      "source": "https://github.com/godotengine/godot.git",
      "note": "Rebranded per workspace/bahyway_v4/godot/patch_engine_source.py (shared with playbook_262)."
    },
    {
      "name": "girsu-vscodium-src",
      "path": "/assets/girsu-vscodium-src",
      "version": null,
      "source": null,
      "note": "Deliberately empty. Girsu IDE's build lives entirely outside this repo -- this slot exists so it CAN be folded in later, without this image guessing its contents now."
    }
  ]
}
