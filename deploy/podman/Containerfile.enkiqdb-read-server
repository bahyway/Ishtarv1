# =============================================================================
# enkiqdb-read-server — EnkiQDB (Quarantine Archive) Read Node container
# image. There is deliberately no enkiqdb-write-server image: EnkiQDB is
# fed in-process by enkisdb-write-server's ValidationSweep
# (`QdbStore::drain_from_sdb`) -- see
# deploy/podman/Containerfile.enkisdb-write-server's header. This
# container only ever reads the materialized qdb/ Data File tree that
# process produces.
#
# Build (from the repo root):
#   podman build -t enkiqdb-read-server:latest \
#     -f deploy/podman/Containerfile.enkiqdb-read-server \
#     workspace/bahyway_v4
#
# Run:
#   podman run -d --name enkiqdb-read \
#     -p 7005:7005 \
#     -v enkiqdb-read-data:/data:Z \
#     -e RELOAD_SECS=30 \
#     --restart=always \
#     enkiqdb-read-server:latest
#
# Lifecycle (no systemd anywhere -- plain Podman commands):
#   podman stop enkiqdb-read
#   podman start enkiqdb-read
#   podman logs -f enkiqdb-read
#
# Data path: this container never writes -- it only opens
# /data/current/{entities,eav} read-only and reloads on a timer. Getting
# enkisdb-write's materialized qdb/ tree into that path is a separate
# step; see scripts/enkiqdb-sync-data.sh.
#
# `:Z` on the volume mount is required on Fedora/SELinux-enforcing hosts.
# =============================================================================
FROM docker.io/library/rust:1-slim AS builder
WORKDIR /build
COPY . .
RUN cargo build --release -p enkiqdb-read-server

FROM registry.fedoraproject.org/fedora-minimal:latest
RUN microdnf install -y shadow-utils && microdnf clean all \
    && useradd --system --home-dir /data --create-home enkiqdb
COPY --from=builder /build/target/release/enkiqdb-read-server /usr/local/bin/enkiqdb-read-server
USER enkiqdb
WORKDIR /data
ENV BIND_ADDR=0.0.0.0:7005
ENV DATA_DIR=/data
EXPOSE 7005
ENTRYPOINT ["/usr/local/bin/enkiqdb-read-server"]
