# =============================================================================
# enkidw-write-server — EnkiDW (Data Warehouse) Write Node container image.
#
# Build (from the repo root):
#   podman build -t enkidw-write-server:latest \
#     -f deploy/podman/Containerfile.enkidw-write-server \
#     workspace/bahyway_v4
#
# Run:
#   podman run -d --name enkidw-write \
#     -p 7012:7012 \
#     -v enkidw-write-data:/data:Z \
#     -e TRIBE_ID=0x7005 \
#     --restart=always \
#     enkidw-write-server:latest
#
# Landing zone: this server polls LANDING_DIR (default /data/dw/landing,
# inside the same /data volume) every POLL_SECS for files to ingest via
# EnkiDW's real EtlPipeline -- drop files there (e.g. via `podman cp` or
# a bind-mounted subdirectory) to feed it.
#
# Lifecycle (no systemd anywhere -- plain Podman commands):
#   podman stop enkidw-write
#   podman start enkidw-write
#   podman logs -f enkidw-write
#
# Backup: the volume (enkidw-write-data), not the container, is what
# holds state (PERSIST_DIR's disk journal is the durability boundary) --
# back up its mounted directory directly rather than `podman commit`.
#
# `:Z` on the volume mount is required on Fedora/SELinux-enforcing hosts.
# =============================================================================
FROM docker.io/library/rust:1-slim AS builder
WORKDIR /build
COPY . .
RUN cargo build --release -p enkidw-write-server

FROM registry.fedoraproject.org/fedora-minimal:latest
RUN microdnf install -y shadow-utils && microdnf clean all \
    && useradd --system --home-dir /data --create-home enkidw
COPY --from=builder /build/target/release/enkidw-write-server /usr/local/bin/enkidw-write-server
USER enkidw
WORKDIR /data
ENV BIND_ADDR=0.0.0.0:7012
ENV DATA_DIR=/data/dw
ENV LANDING_DIR=/data/dw/landing
ENV PERSIST_DIR=/data/dw/persist
EXPOSE 7012
ENTRYPOINT ["/usr/local/bin/enkidw-write-server"]
