{
  "name": "dubsar-ide",
  "displayName": "DubSar IDE",
  "description": "7D particle simulation & storage fragmentation visualization for VSCodium",
  "version": "0.1.0",
  "publisher": "bahyway",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Notebooks", "Data Science", "Visualization"],
  "keywords": ["rust", "vulkan", "jupyter", "simulation", "particle", "storage"],

  "activationEvents": [
    "onNotebook:dubsar",
    "onCommand:dubsar.openStorageSim",
    "onCommand:dubsar.installKernel"
  ],

  "main": "./out/extension.js",

  "contributes": {
    "notebooks": [
      {
        "type": "dubsar",
        "displayName": "DubSar Notebook",
        "selector": [{ "filenamePattern": "*.dubsar" }],
        "priority": "default"
      }
    ],

    "notebookRenderer": [
      {
        "id": "dubsar-particle-viewport",
        "displayName": "DubSar 3D Viewport",
        "entrypoint": "./out/viewport-renderer.js",
        "mimeTypes": [
          "image/png",
          "application/vnd.dubsar.simulation+json",
          "application/json"
        ]
      }
    ],

    "commands": [
      {
        "command": "dubsar.openStorageSim",
        "title": "Open Storage Fragmentation Simulation",
        "category": "DubSar"
      },
      {
        "command": "dubsar.installKernel",
        "title": "Install DubSar Jupyter Kernel",
        "category": "DubSar"
      },
      {
        "command": "dubsar.render3d",
        "title": "Render 3D Viewport",
        "category": "DubSar"
      },
      {
        "command": "dubsar.setProjection",
        "title": "Set 7D→3D Projection",
        "category": "DubSar"
      }
    ],

    "keybindings": [
      {
        "command": "notebook.cell.execute",
        "key": "ctrl+enter",
        "when": "notebookEditorFocused"
      },
      {
        "command": "dubsar.render3d",
        "key": "shift+F5",
        "when": "notebookEditorFocused"
      }
    ],

    "configuration": {
      "title": "DubSar IDE",
      "properties": {
        "dubsar.kernelPath": {
          "type": "string",
          "default": "dubsar-kernel",
          "description": "Path to the dubsar-kernel binary"
        },
        "dubsar.backend": {
          "type": "string",
          "enum": ["software", "wgpu", "vulkan"],
          "default": "software",
          "description": "Rendering backend: software (VM/no GPU), wgpu (cross-platform), vulkan (bare-metal)"
        },
        "dubsar.particleCount": {
          "type": "number",
          "default": 100000,
          "description": "Default particle count for new simulations"
        },
        "dubsar.maxVisible": {
          "type": "number",
          "default": 500000,
          "description": "Maximum visible particles after LOD downsampling"
        }
      }
    },

    "languages": [
      {
        "id": "dubsar",
        "aliases": ["DubSar", "dubsar"],
        "extensions": [".dubsar"],
        "icon": { "light": "./icons/dubsar-light.svg", "dark": "./icons/dubsar-dark.svg" }
      }
    ]
  },

  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },

  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "eslint": "^8"
  },

  "dependencies": {
    "three": "^0.165.0",
    "@types/three": "^0.165.0"
  }
}
